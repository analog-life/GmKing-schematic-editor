{
  "name": "@edahelper/schematic",
  "version": "1.0.1-beta",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./core": {
      "types": "./dist/schematic/portableEntry.d.ts",
      "import": "./dist/schematic/portableEntry.js",
      "default": "./dist/schematic/portableEntry.js"
    },
    "./viewer": {
      "types": "./dist/schematic/viewer.d.ts",
      "import": "./dist/schematic/viewer.js",
      "default": "./dist/schematic/viewer.js"
    },
    "./editor": {
      "types": "./dist/schematic/interactiveEntry.d.ts",
      "import": "./dist/schematic/interactiveEntry.js",
      "default": "./dist/schematic/interactiveEntry.js"
    },
    "./web": {
      "types": "./dist/schematic/schematicWebEntry.d.ts",
      "import": "./dist/schematic/schematicWebEntry.js",
      "default": "./dist/schematic/schematicWebEntry.js"
    },
    "./workspace": {
      "types": "./dist/schematic/workspaceEntry.d.ts",
      "import": "./dist/schematic/workspaceEntry.js",
      "default": "./dist/schematic/workspaceEntry.js"
    },
    "./analysis": {
      "types": "./dist/schematic/analysis/analysis.d.ts",
      "import": "./dist/schematic/analysis/analysis.js",
      "default": "./dist/schematic/analysis/analysis.js"
    },
    "./styles/editor.css": "./dist/styles/editor.css",
    "./styles/web.css": "./dist/styles/web.css"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:full": "node ../../scripts/run-vitest.mjs --include-slow",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@joint/core": "^4.1.3",
    "dompurify": "^3.4.18",
    "json-stringify-pretty-compact": "^4.0.0",
    "nerdamer": "^1.1.13"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "license": "MIT",
  "author": "RarityBrown"
}
